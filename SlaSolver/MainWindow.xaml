<Window
    x:Class="SlaSolver.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
    Title="Решение СЛАУ"
    Width="1200"
    Height="700"
    WindowStartupLocation="CenterScreen">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Row 0: Панель управления  -->
        <StackPanel
            Grid.Row="0"
            Margin="0,0,0,12"
            Orientation="Horizontal">
            <TextBlock
                Margin="0,0,8,0"
                VerticalAlignment="Center"
                Text="Размерность:" />
            <ComboBox
                x:Name="SizeCombo"
                Width="60"
                SelectionChanged="SizeCombo_SelectionChanged" />
            <TextBlock
                Margin="24,0,8,0"
                VerticalAlignment="Center"
                Text="Метод:" />
            <ComboBox
                x:Name="MethodCombo"
                Width="220"
                DisplayMemberPath="MethodName"
                SelectedValuePath="MethodName" />
            <CheckBox
                x:Name="CompareAllCheck"
                Margin="24,0,0,0"
                VerticalAlignment="Center"
                Content="Сравнить все методы" />
        </StackPanel>

        <!--  Row 1: Матрица + Вектор b + ГРАФИК  -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                <TextBlock
                    Margin="0,0,0,8"
                    HorizontalAlignment="Center"
                    FontWeight="Bold"
                    Text="Матрица A" />
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <UniformGrid x:Name="MatrixGrid" Columns="1" />
                </ScrollViewer>
            </StackPanel>

            <StackPanel Grid.Column="1" Margin="0,0,16,0">
                <TextBlock
                    Margin="0,0,0,8"
                    HorizontalAlignment="Center"
                    FontWeight="Bold"
                    Text="Вектор b" />
                <StackPanel x:Name="VectorBPanel" />
            </StackPanel>

            <GroupBox Grid.Column="2" Header="График функции">
                <lvc:CartesianChart x:Name="SolutionChart" />
            </GroupBox>
        </Grid>

        <!--  Row 2: Кнопка  -->
        <Button
            Grid.Row="2"
            Width="140"
            Height="34"
            Margin="0,16,0,0"
            HorizontalAlignment="Left"
            Click="SolveButton_Click"
            Content="Решить" />

        <!--  Row 3-4: Ответ  -->
        <TextBlock
            Grid.Row="3"
            Margin="0,16,0,4"
            FontWeight="Bold"
            Text="Ответ:" />
        <TextBox
            x:Name="ResultBox"
            Grid.Row="4"
            Height="80"
            FontFamily="Consolas"
            FontSize="14"
            IsReadOnly="True"
            TextWrapping="Wrap"
            VerticalScrollBarVisibility="Auto" />
    </Grid>
</Window>
