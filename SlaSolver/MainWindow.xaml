<Window x:Class="SlaSolver.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Решение СЛАУ" Height="620" Width="900"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- панель управления -->
            <RowDefinition Height="*"/>
            <!-- ввод -->
            <RowDefinition Height="Auto"/>
            <!-- кнопка -->
            <RowDefinition Height="Auto"/>
            <!-- подпись "Ответ" -->
            <RowDefinition Height="Auto"/>
            <!-- поле ответа -->
        </Grid.RowDefinitions>

        <!-- Верхняя панель управления -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="Размерность:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox x:Name="SizeCombo" Width="60"
                      SelectionChanged="SizeCombo_SelectionChanged"/>

            <TextBlock Text="Метод:" VerticalAlignment="Center" Margin="24,0,8,0"/>
            <ComboBox x:Name="MethodCombo" Width="220"
                      DisplayMemberPath="MethodName"
                      SelectedValuePath="MethodName"/>
        </StackPanel>

        <!-- Область ввода: две колонки, в каждой заголовок + поля -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Колонка матрицы A -->
            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                <TextBlock Text="Матрица A" FontWeight="Bold"
                           HorizontalAlignment="Center" Margin="0,0,0,8"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto">
                    <UniformGrid x:Name="MatrixGrid" Columns="1"/>
                </ScrollViewer>
            </StackPanel>

            <!-- Колонка вектора b -->
            <StackPanel Grid.Column="1">
                <TextBlock Text="Вектор b" FontWeight="Bold"
                           HorizontalAlignment="Center" Margin="0,0,0,8"/>
                <StackPanel x:Name="VectorBPanel"/>
            </StackPanel>
        </Grid>

        <!-- Кнопка -->
        <Button Grid.Row="2" Content="Решить"
                Width="140" Height="34" Margin="0,16,0,0"
                HorizontalAlignment="Left"
                Click="SolveButton_Click"/>

        <!-- Результат -->
        <TextBlock Grid.Row="3" Text="Ответ:" FontWeight="Bold"
                   Margin="0,16,0,4"/>
        <TextBox Grid.Row="4" x:Name="ResultBox"
                 IsReadOnly="True" Height="80" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 FontFamily="Consolas" FontSize="14"/>
    </Grid>
</Window>